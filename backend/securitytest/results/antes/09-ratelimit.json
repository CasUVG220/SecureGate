{
  "id": "09-ratelimit",
  "titulo": "Rate limit real: /licencias/activar, /auth/login y demás límites de producción",
  "fecha": "2026-09-29T23:15:10.621Z",
  "base": "http://localhost:3000",
  "items": [
    {
      "id": "RL-activar-limite",
      "titulo": "13 activaciones con códigos inválidos desde una IP",
      "esperado": "404 ×10 y 429 desde el intento 11",
      "request": {
        "method": "POST",
        "path": "/api/licencias/activar",
        "actor": "anónimo (13 intentos)"
      },
      "real": {
        "status": 429,
        "body": "404×10, 429×3; primer 429 en el intento 11"
      },
      "resultado": "OK",
      "severidad": "alta"
    },
    {
      "id": "RL-activar-cabeceras",
      "titulo": "El 429 informa el límite y el tiempo de espera",
      "esperado": "ratelimit-limit=10 y retry-after / ratelimit-reset",
      "request": {
        "method": "POST",
        "path": "/api/licencias/activar",
        "actor": "anónimo"
      },
      "real": {
        "status": 429,
        "body": "ratelimit-limit=10; ratelimit-remaining=0; retry-after=900; ratelimit-reset=900"
      },
      "resultado": "OK",
      "severidad": "baja"
    },
    {
      "id": "RL-activar-xff",
      "titulo": "Rotar X-Forwarded-For en cada intento no reinicia el contador",
      "esperado": "429 en los 5",
      "request": {
        "method": "POST",
        "path": "/api/licencias/activar",
        "actor": "anónimo + XFF aleatorio"
      },
      "real": {
        "status": 429,
        "body": "429×5"
      },
      "resultado": "OK",
      "severidad": "alta"
    },
    {
      "id": "RL-activar-valido-bloqueado",
      "titulo": "Un código válido tampoco pasa cuando se agotó el cupo de la IP",
      "esperado": "429 (informativo: el límite cuenta también los intentos correctos)",
      "request": {
        "method": "POST",
        "path": "/api/licencias/activar",
        "actor": "anónimo, código válido"
      },
      "real": {
        "status": 429,
        "body": "{\"error\":\"Demasiados intentos de activación\"}"
      },
      "resultado": "INFO",
      "nota": "Una garita detrás del mismo NAT que un atacante no puede activarse durante 15 min. Aceptable frente a la fuerza bruta, a costa de disponibilidad."
    },
    {
      "id": "RL-login-cuenta",
      "titulo": "12 contraseñas erróneas contra UNA cuenta (desde una IP)",
      "esperado": "401 ×10 y 429 desde el 11 (límite por cuenta)",
      "request": {
        "method": "POST",
        "path": "/api/auth/login",
        "actor": "anónimo"
      },
      "real": {
        "status": 429,
        "body": "401×10, 429×2; primer 429 en el intento 11; mensaje: {\"error\":\"Demasiados intentos para esta cuenta; espera 15 minutos\"}"
      },
      "resultado": "OK",
      "severidad": "alta"
    },
    {
      "id": "RL-login-cuenta-bloquea-titular",
      "titulo": "Con la cuenta bloqueada, el titular con la contraseña CORRECTA también recibe 429",
      "esperado": "informativo",
      "request": {
        "method": "POST",
        "path": "/api/auth/login",
        "actor": "titular legítimo"
      },
      "real": {
        "status": 429,
        "body": "{\"error\":\"Demasiados intentos para esta cuenta; espera 15 minutos\"}"
      },
      "resultado": "INFO",
      "nota": "Cualquiera que conozca el correo de una cuenta (incluida la del owner) puede dejarla sin acceso 15 min con 10 peticiones. Trade-off documentado en auth.routes.ts; conviene añadir aviso al titular y no bloquear a quien llega con un dispositivo/IP ya conocido."
    },
