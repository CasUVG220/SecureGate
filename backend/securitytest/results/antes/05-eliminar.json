    {
      "id": "ELIM-audit-intentos-fallidos",
      "titulo": "Cada intento fallido que llega al controlador deja fila en audit_logs (usuario, IP, empresa, status 403)",
      "esperado": "5 filas con status_code 403, usuario = owner, ip_address y registro_id = empresa",
      "request": {
        "method": "SQL",
        "path": "audit_logs WHERE accion='EMPRESA_ELIMINADA_DEFINITIVO' AND registro_id=<C>",
        "actor": "psql"
      },
      "real": {
        "status": 0,
        "body": "filas=5 (403: 5, 429: 0); ejemplo: 403|2f659ec0-7b9f-4b3d-83df-d00058769fb2|::ffff:192.168.65.1|e13bdb76-b94d-4986-9102-307728e29404|NULL"
      },
      "resultado": "OK",
      "severidad": "media"
    },
    {
      "id": "ELIM-audit-bloqueados-por-limitador",
      "titulo": "Los intentos bloqueados por el limitador (429) también quedan en la bitácora",
      "esperado": "los 2 intentos con 429 aparecen en audit_logs",
      "request": {
        "method": "SQL",
        "path": "audit_logs (status_code = 429)",
        "actor": "psql"
      },
      "real": {
        "status": 0,
        "body": "filas 429 = 0 de 2 intentos bloqueados. El limitador se ejecuta ANTES que auditLog, así que el atacante que insiste tras el bloqueo no deja rastro."
      },
      "resultado": "FALLA",
      "severidad": "baja",
      "nota": "Hueco de auditoría menor: solo los primeros 5 intentos quedan registrados por ventana de 15 min."
    },
