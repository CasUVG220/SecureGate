    {
      "id": "JWT-ttl-acceso",
      "titulo": "Duración del access token",
      "esperado": "≤ 1 h",
      "request": {
        "method": "POST",
        "path": "/api/auth/login",
        "actor": "owner"
      },
      "real": {
        "status": 200,
        "body": "exp - iat = 3600 s; claims: id, nombre, email, rol, sucursal_id, empresa_id, iat, exp"
      },
      "resultado": "OK",
      "severidad": "baja"
    },
    {
