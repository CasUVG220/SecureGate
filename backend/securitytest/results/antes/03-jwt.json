    {
      "id": "JWT-revocacion-usuario",
      "titulo": "Un usuario dado de baja pierde el access token, el refresh y el login al instante",
      "esperado": "antes 200/403 (según rol); baja 200; después 401; refresh 401; login 401",
      "request": {
        "method": "DELETE",
        "path": "/api/usuarios/:id (cobaya)",
        "actor": "adminSucA1"
      },
      "real": {
        "status": 401,
        "body": "baja=200, token tras baja=401 ({\"error\":\"Sesión revocada\"}), refresh=401, login=401"
      },
      "resultado": "OK",
      "severidad": "alta"
    },
    {
      "id": "JWT-refresh-rotacion",
      "titulo": "El refresh token rota y el anterior queda inválido",
      "esperado": "reuso del anterior → 401",
      "request": {
        "method": "POST",
        "path": "/api/auth/refresh",
        "actor": "residente A1 (cookie)"
      },
      "real": {
        "status": 401,
        "body": "1er refresh=200; reuso del viejo=401"
      },
      "resultado": "OK",
      "severidad": "alta"
    },
    {
      "id": "JWT-refresh-deteccion-reuso",
      "titulo": "Detección de reutilización: al reusar un refresh robado se revoca toda la familia",
      "esperado": "tras el reuso del viejo, el refresh nuevo también deja de valer (401)",
      "request": {
        "method": "POST",
        "path": "/api/auth/refresh",
        "actor": "residente A1 (cookie nueva tras el reuso)"
      },
      "real": {
        "status": 200,
        "body": "refresh nuevo tras reuso del viejo=200"
      },
      "resultado": "FALLA",
      "severidad": "baja",
      "nota": "Conocido y aceptado en SECURITY_REVIEW.md (M6 «pendiente»). Un refresh robado y usado ANTES que el legítimo deja al atacante con sesión; el legítimo recibe 401 pero nadie se entera."
    },
    {
      "id": "JWT-cookie-flags",
