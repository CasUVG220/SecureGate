NODE_ENV=production
PORT=3000
# Contraseña de ejemplo: cámbiala. El backend se niega a arrancar en producción
# con la contraseña de desarrollo del repositorio.
DATABASE_URL=postgresql://sguser:CAMBIA_ESTA_CLAVE@db:5432/securegate

# Obligatorio. >= 32 caracteres; genera uno con:  openssl rand -hex 48
# En producción el backend NO arranca si falta, es corto o es un valor público.
# (En desarrollo, si falta, se genera uno aleatorio por ejecución.)
JWT_SECRET=

# Orígenes permitidos por CORS, separados por coma. Obligatorio en producción.
ALLOWED_ORIGINS=https://DOMINIO

# Saltos de proxy delante del backend (0 = ninguno). Detrás de nginx: 1.
# Sin esto req.ip es la del proxy y X-Forwarded-For no se cree.
TRUST_PROXY=1

# Clave de Google Cloud Vision (OCR de respaldo). Se manda en un header, no en la URL.
# GOOGLE_CLOUD_API_KEY=

# ── SOLO DESARROLLO — no definir en producción ──────────────────────────────
# Siembra las cuentas demo de database/seed-dev.sql (contraseñas públicas).
# SEED_DEMO=true
# Habilita el pago con tarjeta SIMULADO (liquida la deuda con cualquier tarjeta).
# PAGOS_TARJETA_SIMULADA=true

# Máximo de conexiones concurrentes del pool de pg (backend/src/db/pool.ts).
# Default 20 si no se define — pensado para la VM actual (e2-micro, un solo
# backend Node) con margen bajo max_connections=100 de Postgres 15. Subir si
# se migra a una VM más grande o a Cloud SQL (Sprint 8).
# DB_POOL_MAX=20

# Límites de intentos (por 15 min, sólo cuentan los FALLIDOS en el login).
# Overrides pensados para pruebas de carga (backend/loadtest/).
# RATE_LIMIT_GENERAL_MAX=1000        # por IP, todas las rutas
# RATE_LIMIT_LOGIN_MAX=20            # login fallidos por IP
# RATE_LIMIT_LOGIN_CUENTA_MAX=10     # login fallidos por cuenta (correo)
