NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://sguser:sgpassword123@db:5432/securegate
JWT_SECRET=change_me_in_production
ALLOWED_ORIGINS=https://DOMINIO

# Máximo de conexiones concurrentes del pool de pg (backend/src/db/pool.ts).
# Default 20 si no se define — pensado para la VM actual (e2-micro, un solo
# backend Node) con margen bajo max_connections=100 de Postgres 15. Subir si
# se migra a una VM más grande o a Cloud SQL (Sprint 8).
# DB_POOL_MAX=20

# Opcionales, solo para pruebas de carga (backend/loadtest/). Sin definir,
# se usan los límites de producción (1000 / 10 por IP cada 15 min).
# RATE_LIMIT_GENERAL_MAX=100000
# RATE_LIMIT_LOGIN_MAX=100000
