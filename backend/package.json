{
  "name": "backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "loadtest:smoke": "artillery run loadtest/smoke.yml",
    "loadtest:login": "artillery run loadtest/carga-login.yml --output loadtest/results/carga-login.json",
    "loadtest:dashboard": "artillery run loadtest/carga-dashboard.yml --output loadtest/results/carga-dashboard.json",
    "loadtest:estres": "artillery run loadtest/estres-accesos.yml --output loadtest/results/estres-accesos.json",
    "loadtest:report": "node loadtest/generate-reports.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.0",
    "node-cron": "^3.0.3",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.10.0",
    "artillery": "^2.0.34",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
