# Variables para `docker compose` (se leen automáticamente desde un archivo
# `.env` en esta carpeta; `.env` está en .gitignore, este archivo NO).
#
#   cp .env.example .env   y completa los valores.

# ── Obligatorio en producción ────────────────────────────────────────────────
# Firma las sesiones Y los tokens de licencia de las garitas. Mínimo 32
# caracteres; el backend se niega a arrancar en producción si es corto o es uno
# de los valores públicos del repositorio.
#   openssl rand -hex 48
JWT_SECRET=

# Orígenes que pueden llamar a la API (CORS), separados por coma. Obligatorio en
# producción: https://tu-dominio.com
ALLOWED_ORIGINS=

# ── Sólo producción (docker-compose.prod.yml) ────────────────────────────────
# PUBLIC_URL=https://tu-dominio.com
# DATABASE_URL=postgresql://USUARIO:PASSWORD@cloud-sql-proxy:5432/securegate
# CLOUD_SQL_CONNECTION_NAME=securegate-503823:northamerica-south1:securegate-pg

# ── Opcionales ───────────────────────────────────────────────────────────────
# Llave de los secretos de la verificación en dos pasos de los administradores. Si no se define, se deriva de
# JWT_SECRET. Pon aquí el valor ACTUAL de JWT_SECRET antes de rotar JWT_SECRET (si no, los administradores que ya la
# activaron tendrían que restablecerla). Mínimo 32 caracteres:  openssl rand -hex 32
# TWOFA_KEY=
# Contraseña del Postgres LOCAL de desarrollo (default: sgpassword123).
# POSTGRES_PASSWORD=

# El primer owner de producción se crea a mano (ya no hay cuentas demo):
#   OWNER_EMAIL=ana@empresa.com OWNER_PASSWORD='...' OWNER_NOMBRE='Ana' \
#     docker compose -f docker-compose.prod.yml run --rm backend node dist/scripts/crear-owner.js
