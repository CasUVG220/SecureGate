worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile on;
    keepalive_timeout 65;
    server_tokens off;

    # Cuerpos: 8 MB alcanzan para una foto en base64 (OCR, comprobante, área);
    # el backend aplica además su propio límite por ruta.
    client_max_body_size 8m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               text/javascript application/x-javascript;
    gzip_min_length 256;

    # Límites por IP como primera barrera (el backend tiene los suyos por
    # cuenta y por ruta). Una zona más estricta para credenciales.
    limit_req_zone $binary_remote_addr zone=api:10m  rate=20r/s;
    limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/s;
    limit_req_status 429;

    # Redirect HTTP → HTTPS
    server {
        listen 80;
        server_name DOMINIO;

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # HTTPS
    server {
        listen 443 ssl;
        http2 on;
        server_name DOMINIO;

        ssl_certificate     /etc/letsencrypt/live/DOMINIO/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/DOMINIO/privkey.pem;

        # Perfil "intermediate" de Mozilla (TLS 1.2 con AEAD + TLS 1.3).
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
        ssl_prefer_server_ciphers off;
        ssl_session_cache   shared:SSL:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;

        # Encabezados de seguridad. `always` los añade también en respuestas de
        # error (sin él, un 4xx/5xx salía sin ellos).
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        # CSP de la SPA: sólo su propio origen (la API cuelga del mismo dominio),
        # más Google Fonts, que usa index.html.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

        # Credenciales: más estricto que el resto de la API.
        location /api/auth/ {
            limit_req zone=auth burst=10 nodelay;
            proxy_pass         http://backend:3000;
            proxy_http_version 1.1;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $remote_addr;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # Backend API. X-Forwarded-For se SOBRESCRIBE con la IP real del cliente
        # (no se concatena con lo que mande el cliente) y el backend confía en
        # exactamente un salto (TRUST_PROXY=1): un cliente ya no puede falsificar
        # su IP para evadir el rate limit ni ensuciar la auditoría.
        location /api/ {
            limit_req zone=api burst=40 nodelay;
            proxy_pass         http://backend:3000;
            proxy_http_version 1.1;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $remote_addr;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # Health check
        location = /health {
            proxy_pass         http://backend:3000/health;
            proxy_set_header   Host $host;
        }

        # Frontend (archivos estáticos, servidos por el contenedor `frontend`)
        location / {
            proxy_pass         http://frontend:8080;
            proxy_http_version 1.1;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $remote_addr;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }
    }
}
